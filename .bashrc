# source ~/.env
# source your 🔑 's 

# ×××××××××××××××××× [ GNU/Linux & coreutils ] ××××××××××××××××××

# Dynamic Intel/Apple Silicon Homebrew path handling
if [[ -d "/opt/homebrew" ]]; then
  _BREW_PREFIX="/opt/homebrew"
else
  _BREW_PREFIX="/usr/local"
fi

# Note: Users must install these via `brew install coreutils findutils gnu-sed gnu-tar grep gawk`   
export PATH="$_BREW_PREFIX/opt/coreutils/libexec/gnubin:$PATH"
export PATH="$_BREW_PREFIX/opt/findutils/libexec/gnubin:$PATH"
export PATH="$_BREW_PREFIX/opt/gnu-sed/libexec/gnubin:$PATH"
export PATH="$_BREW_PREFIX/opt/gnu-tar/libexec/gnubin:$PATH"
export PATH="$_BREW_PREFIX/opt/grep/libexec/gnubin:$PATH"
export PATH="$_BREW_PREFIX/opt/gawk/libexec/gnubin:$PATH"


# ×××××××××××××××××× [ XDG_BASE ] ××××××××××××××××××
## Standardized directory structure for discerning users
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_STATE_HOME="$HOME/.local/state"


# ×××××××××××××××××× [ alias/else ] ××××××××××××××××××
## Maps Wayland clipboard muscle memory to native macOS
alias wl-copy='pbcopy'
alias wl-paste='pbpaste'

# alias timer='tclock timer'
# alias mdgrab='trafilatura --markdown -u'


# ×××××××××××××××××× [ path / bin Index ] ××××××××××××××××××
_PATHS=(
  "$HOME/.local/pipx/venvs"
  "$HOME/scripts"
  "$HOME/.cargo/bin"
  "$XDG_DATA_HOME/go/bin"
  "$HOME/.var/app"
  "$HOME/.npm-global/bin"
  "$HOME/.local/bin"
)
for p in "${_PATHS[@]}"; do
  if [[ -d "$p" ]]; then
      [[ ":$PATH:" != *":$p:"* ]] && export PATH="$PATH:$p"
  fi
done

unset _PATHS _BREW_PREFIX


# ×××××××××××××××××× [ local vars ] ××××××××××××××××××

export TERM=xterm-256color

## terminal
# ------------------------------
# export TERMINAL=$(which alacritty)
# ------------------------------
# export TERMINAL=$(which wezterm)
# ------------------------------
# export TERMINAL=$(which kitty)
# ------------------------------
# export TERMINAL=$(which foot)

## editor  
# ------------------------------
# export EDITOR=$(which hx)
# export VISUAL=$(which hx)
# ------------------------------
# export EDITOR=$(which vim)
# export VISUAL=$(which vim)
# ------------------------------
# export EDITOR=$(which nvim)
# export VISUAL=$(which nvim)
# ------------------------------
# export EDITOR=$(which emacs)
# export VISUAL=$(which emacs)
# ------------------------------
# export EDITOR=$(which nano)
# export VISUAL=$(which nano)
# ------------------------------
# export EDITOR=$(which micro)
# export VISUAL=$(which micro)

# ×××××××××××××××××× [ pywal16 ] ××××××××××××××××××

## install with pipx

if [[ -f "$XDG_CACHE_HOME/wal/sequences" ]]; then
  (cat "$XDG_CACHE_HOME/wal/sequences" &)
  cat "$XDG_CACHE_HOME/wal/sequences"
fi

if [[ -f "$XDG_CACHE_HOME/wal/colors-tty.sh" ]]; then
  source "$XDG_CACHE_HOME/wal/colors-tty.sh"
fi


# ×××××××××××××××××× [ fastfetch ] ××××××××××××××××××
if command -v fastfetch &> /dev/null; then
  fastfetch --config "$XDG_CONFIG_HOME/fastfetch/config.jsonc"
fi

eval "$(/opt/homebrew/bin/brew shellenv)"
